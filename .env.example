# Copy this file to .env and fill in your keys. Never commit .env.

# Where the Streamlit frontend sends requests
API_URL=http://127.0.0.1:8000

# Optional: override the fingerprint database location
# FINGERPRINT_DB_PATH=data/db/fingerprints.db

# External APIs (see app/integrations/)
AUDD_API_KEY=
CYANITE_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
